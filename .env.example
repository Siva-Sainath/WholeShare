# ==========================================
# SyndicatePay / WholeShare Environment Configuration
# ==========================================

# Runtime & Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syndicate_pay?schema=public"

# PayPal for Business (Developer Sandbox)
# Retrieve from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID="your_sandbox_client_id_here"
PAYPAL_CLIENT_SECRET="your_sandbox_client_secret_here"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID="your_sandbox_webhook_id_here"

# Platform Sandbox Account
PAYPAL_PLATFORM_EMAIL="sb-platform-business@business.example.com"
PAYPAL_PLATFORM_MERCHANT_ID="PLATFORM_MERCHANT_ID"

# Sandbox Buyer Accounts
PAYPAL_BUYER_EMAIL="sb-buyer1@personal.example.com"
PAYPAL_BUYER_PASSWORD="buyer1_password"
PAYPAL_BUYER_1_EMAIL="sb-buyer1@personal.example.com"
PAYPAL_BUYER_1_PASSWORD="buyer1_password"
PAYPAL_BUYER_2_EMAIL="sb-buyer2@personal.example.com"
PAYPAL_BUYER_2_PASSWORD="buyer2_password"
PAYPAL_BUYER_3_EMAIL="sb-buyer3@personal.example.com"
PAYPAL_BUYER_3_PASSWORD="buyer3_password"
PAYPAL_BUYER_4_EMAIL="sb-buyer4@personal.example.com"
PAYPAL_BUYER_4_PASSWORD="buyer4_password"

# Sandbox Wholesale Supplier Account
PAYPAL_SUPPLIER_EMAIL="sb-supplier@business.example.com"
PAYPAL_SUPPLIER_PASSWORD="supplier_password"

# Server & Gateway Parameters
PAYPAL_KEY_RETENTION_HOURS=72
MAX_PENDING_RECHECK_COUNT=5
AUTHORIZATION_VALIDITY_DAYS=29

# Kernel Cloud Browser (B2B Wholesale Scraping)
# Generated at https://onkernel.com/
KERNEL_API_KEY="your_kernel_api_key_here"

# APIMatic Typed SDK Configuration
# OpenAPI Specs: Orders v2, Invoicing v2, Customer Disputes v1
APIMATIC_API_KEY="your_apimatic_key_here"

# Security & Webhook Cryptography
SYNDICATE_HMAC_SECRET="your_32_byte_hex_hmac_secret_here"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
GROK_WEBHOOK_SECRET="your_grok_webhook_secret_here"

# Zapier Accounting Webhook Integration
ZAPIER_SETTLEMENT_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/your_hook_id/"
