{
  "name": "wholeshare",
  "version": "1.0.0",
  "description": "B2B Group Purchasing and Multiparty Escrow Platform on PayPal for Business",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/web/server.js",
    "build": "node --check src/web/server.js src/lib/policy.ts",
    "dev": "node src/web/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --experimental-strip-types --test test/money-math.test.ts test/gateway-spending-limits.test.ts test/gateway-complete-authorization.test.ts test/webhook-verification.test.ts test/idempotency-batch-capture.test.ts test/delivery-confirmation.test.ts test/claims-damage-flow.test.ts test/dispute-supplier-approval.test.ts test/late-dispute.test.ts test/supplier-payout.test.ts test/reconciliation-worker.test.ts test/renewal-lifecycle.test.ts test/escrow-bridge-adapter.test.ts test/clan-governance.test.ts test/clan-lifecycle.test.ts",
    "check:mocks": "node scripts/check-no-mocks.mjs",
    "doctor": "node .cursor/skills/verify-syndicate/control-syndicate.mjs doctor",
    "seed": "node .cursor/skills/verify-syndicate/control-syndicate.mjs seed-demo --reset",
    "verify": "node .cursor/skills/verify-syndicate/control-syndicate.mjs lock-escrow --dry-run",
    "verify:escrow": "node --experimental-strip-types scripts/verify-paypal-live.mjs",
    "verify:zero-sim": "node scripts/verify-zero-simulation.js",
    "lint": "node scripts/lint-code.mjs",
    "lint:features": "node scripts/lint-features.mjs",
    "check": "npm run check:mocks && npm run verify:zero-sim && npm test && npm run test:unit && npm run lint && npm run lint:features",
    "agent:cycle": "node scripts/control-wholeshare.js agent-cycle",
    "tools:list": "node scripts/control-wholeshare.js tools:list",
    "perf": "node scripts/benchmark-runner.mjs",
    "rate-limit": "node scripts/rate-limit-arena.mjs",
    "inference": "node scripts/inference-bench.js",
    "cdp": "node scripts/cdp-harness.mjs inspect",
    "debug:python": "python3 scripts/python-debug-harness.py doctor",
    "eval:model": "node scripts/control-wholeshare.js evaluate-coalition",
    "verify:tokens": "node scripts/control-wholeshare.js verify-tokens",
    "verify:gateway": "node scripts/control-wholeshare.js verify-gateway",
    "verify:fsm": "node scripts/control-wholeshare.js verify-fsm",
    "verify:durable": "node scripts/control-wholeshare.js verify-durable-resume",
    "verify:paypal": "node scripts/control-wholeshare.js verify-paypal-toolkit",
    "gauntlet": "node scripts/control-wholeshare.js adversarial-gauntlet",
    "toolkit:test": "node scripts/test-agent-toolkit.mjs",
    "verify:one-shot": "node scripts/verify-one-shot.js",
    "verify:full-harness": "node scripts/verify-full-harness-flow.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@onkernel/sdk": "^0.139.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@receptron/laya": "^0.2.0",
    "ag-grid-community": "^31.0.0",
    "ag-grid-react": "^31.0.0",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "puppeteer": "^25.16.0",
    "typescript": "^5.8.2"
  }
}
