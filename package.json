{
  "name": "wholeshare",
  "version": "1.0.0",
  "description": "B2B Group Purchasing and Multiparty Escrow Platform on PayPal for Business",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/web/server.js",
    "build": "node --env-file-if-exists=.env scripts/build-client.js && node --check src/web/server.js",
    "dev": "node src/web/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:unit": "node --import ./test/test-env.js --experimental-strip-types --test test/money-math.test.ts test/gateway-spending-limits.test.ts test/gateway-complete-authorization.test.ts test/webhook-verification.test.ts test/idempotency-batch-capture.test.ts test/delivery-confirmation.test.ts test/claims-damage-flow.test.ts test/dispute-supplier-approval.test.ts test/late-dispute.test.ts test/supplier-payout.test.ts test/reconciliation-worker.test.ts test/renewal-lifecycle.test.ts test/escrow-bridge-adapter.test.ts test/clan-governance.test.ts test/clan-lifecycle.test.ts test/reply-check.test.js test/schedule-service.test.js test/model-resilience.test.js",
    "check:mocks": "node scripts/check-no-mocks.js",
    "doctor": "node .cursor/skills/verify-syndicate/control-syndicate.js doctor",
    "seed": "node .cursor/skills/verify-syndicate/control-syndicate.js seed-demo --reset",
    "verify": "node .cursor/skills/verify-syndicate/control-syndicate.js lock-escrow --dry-run",
    "verify:escrow": "node --experimental-strip-types scripts/verify-paypal-live.js",
    "verify:zero-sim": "node scripts/verify-zero-simulation.js",
    "lint": "node scripts/lint-code.js",
    "lint:features": "node scripts/lint-features.js",
    "check": "npm run check:mocks && npm run verify:zero-sim && npm test && npm run test:unit && npm run lint && npm run lint:features",
    "agent:cycle": "node scripts/control-wholeshare.js agent-cycle",
    "tools:list": "node scripts/control-wholeshare.js tools:list",
    "perf": "node scripts/benchmark-runner.js",
    "rate-limit": "node scripts/rate-limit-arena.js",
    "inference": "node scripts/inference-bench.js",
    "cdp": "node scripts/cdp-harness.js inspect",
    "debug:python": "python3 scripts/python-debug-harness.py doctor",
    "eval:model": "node scripts/control-wholeshare.js evaluate-coalition",
    "verify:tokens": "node scripts/control-wholeshare.js verify-tokens",
    "verify:gateway": "node scripts/control-wholeshare.js verify-gateway",
    "verify:fsm": "node scripts/control-wholeshare.js verify-fsm",
    "verify:durable": "node scripts/control-wholeshare.js verify-durable-resume",
    "verify:paypal": "node scripts/control-wholeshare.js verify-paypal-toolkit",
    "gauntlet": "node scripts/control-wholeshare.js adversarial-gauntlet",
    "toolkit:test": "node scripts/test-agent-toolkit.js",
    "verify:one-shot": "node scripts/verify-one-shot.js",
    "verify:full-harness": "node scripts/verify-full-harness-flow.js",
    "verify-webmcp": "node scripts/verify-webmcp.js",
    "verify:controls": "node scripts/verify-no-dead-controls.js",
    "verify:mosaic": "node scripts/verify-mosaic.js",
    "verify:ui": "node scripts/verify-ui-layout.js",
    "eval:mosaic": "node scripts/eval-mosaic.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@astryxdesign/core": "^0.7.11",
    "@astryxdesign/theme-neutral": "^0.7.11",
    "@bryntum/calendar-enterprise": "^8.0.0",
    "@bryntum/gantt-enterprise": "^8.0.0",
    "@bryntum/grid-enterprise": "^8.0.0",
    "@bryntum/scheduler-enterprise": "8.0.0",
    "@bryntum/taskboard-enterprise": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@onkernel/sdk": "^0.139.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@receptron/laya": "^0.2.0",
    "@stylexjs/stylex": "^0.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ag-charts-enterprise": "^14.3.0",
    "ag-grid-community": "^36.3.0",
    "ag-grid-enterprise": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "ag-studio-react": "^3.1.0",
    "dotenv": "^18.0.9",
    "gsap": "^3.15.1",
    "lucide-react": "^1.70.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.11",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "puppeteer": "^25.16.0",
    "typescript": "^5.9.3"
  }
}
